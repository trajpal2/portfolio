# Copy this file to .env.local and fill in real values
PORT=3000
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console HTML tag verification (optional)
# Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SMTP settings (Gmail / cPanel mail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tushant.rajpal23@gmail.com
SMTP_PASS=your_gmail_app_password

# From / Reply-To addresses
CONTACT_FROM_EMAIL=tushant.rajpal23@gmail.com
CONTACT_REPLY_TO=tushant.rajpal23@gmail.com
