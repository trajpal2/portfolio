 approach was based on systematically replacing Jest APIs with their Vitest equivalents."}],["$","p",null,{"children":"Common mappings include:"}],["$","pre",null,{"className":"code-block","children":"jest.fn()              → vi.fn()\njest.spyOn()           → vi.spyOn()\njest.mock()            → vi.mock()\njest.useFakeTimers()   → vi.useFakeTimers()\njest.clearAllMocks()   → vi.clearAllMocks()\njest.resetAllMocks()   → vi.resetAllMocks()"}]]}],["$","$Ld",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Migration Architecture"}],["$","pre",null,{"className":"code-block","children":"Existing React Application\n          │\n          ▼\n      Vite Build\n          │\n          ▼\n   Vitest Test Runner\n          │\n     ┌────┴────┐\n     ▼         ▼\n Unit Tests   Integration Tests"}]]}],["$","$Ld",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Key Consideration"}],["$","p",null,{"children":"A migration should not blindly perform global text replacement."}],["$","p",null,{"children":"The test suite needs to be evaluated for:"}],["$","div",null,{"className":"chip-grid","children":[["$","span","Jest globals",{"className":"chip","children":"Jest globals"}],["$","span","Jest configuration",{"className":"chip","children":"Jest configuration"}],["$","span","Mock behavior",{"className":"chip","children":"Mock behavior"}],["$","span","Timer behavior",{"className":"chip","children":"Timer behavior"}],["$","span","Module mocking",{"className":"chip","children":"Module mocking"}],["$","span","Environment configuration",{"className":"chip","children":"Environment configuration"}],["$","span","Setup files",{"className":"chip","children":"Setup files"}],["$","span","Snapshot behavior",{"className":"chip","children":"Snapshot behavior"}],["$","span","TypeScript definitions",{"className":"chip","children":"TypeScript definitions"}],["$","span","Vite compatibility",{"className":"chip","children":"Vite compatibility"}]]}]]}],["$","$Ld",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Why Vitest"}],["$","p",null,{"children":"For a Vite-based application, Vitest provides a testing environment closely aligned with the Vite ecosystem."}],"$Le"]}],"$Lf","$L10","$L11","$L12"]}]}]],null,"$L13"]}]
