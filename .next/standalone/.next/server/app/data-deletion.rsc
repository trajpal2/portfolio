11:["$","$Le","5. How to submit a deletion request",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"5. How to submit a deletion request"}],[["$","p","5. How to submit a deletion request-p-0",{"children":"Email tushant.rajpal23@gmail.com with the subject line: “Data deletion request”."}]],["$","ul",null,{"children":[["$","li","5. How to submit a deletion request-li-0",{"children":"Include the email address you used when contacting us (and any alternate addresses)."}],["$","li","5. How to submit a deletion request-li-1",{"children":"Approximate date of your message or interaction, if known."}],["$","li","5. How to submit a deletion request-li-2",{"children":"Optional: a short description of what you want removed."}]]}],["$","p",null,{"className":"legal-doc__note","children":"We may ask for simple verification (for example, confirming details from your original message) so we do not delete someone else’s data by mistake."}]]}]
12:["$","$Le","6. Timeline",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"6. Timeline"}],[["$","p","6. Timeline-p-0",{"children":"We aim to acknowledge requests within 7 days and complete deletion within 30 days of verification, unless a lawful reason requires a different schedule. If more time is needed, we will tell you why."}]],null,null]}]
13:["$","$Le","7. After deletion",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"7. After deletion"}],[["$","p","7. After deletion-p-0",{"children":"Once deletion is completed, we will no longer use your contact details to follow up on that enquiry. You may still visit the public portfolio freely. If you contact us again later, a new record may be created from that new submission."}]],null,null]}]
