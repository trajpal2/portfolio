a:["$","$1","c",{"children":[[["$","section",null,{"className":"page-hero-band","children":["$","div",null,{"className":"section__inner","children":[["$","p",null,{"className":"eyebrow","children":"Legal"}],["$","h1",null,{"children":"Data Deletion"}],["$","p",null,{"className":"section__lead page-hero-band__lead","children":"How to request deletion of personal data associated with Tushant Rajpal's portfolio website and contact channels."}],null]}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"section__inner legal-doc","children":[["$","p",null,{"className":"legal-doc__updated","children":["Last updated: ","August 30, 2026"]}],[["$","$Le","1. Purpose of this page",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"1. Purpose of this page"}],[["$","p","1. Purpose of this page-p-0",{"children":"This page explains how visitors and contacts can request deletion of personal data that may have been collected through this personal portfolio — for example via the contact form or email correspondence."}],["$","p","1. Purpose of this page-p-1",{"children":"The Site is operated by Tushant Rajpal to present professional experience across industries and technologies. It is not a user-account product; most visitors leave no stored profile. Deletion requests mainly apply when you have shared personal details with us."}]],null,null]}],["$","$Le","2. What personal data may exist",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"2. What personal data may exist"}],[["$","p","2. What personal data may exist-p-0",{"children":"Depending on how you interacted with the Site, we may hold:"}]],["$","ul",null,{"children":[["$","li","2. What personal data may exist-li-0",{"children":"Contact form submissions (name, email, company, project notes, message)."}],["$","li","2. What personal data may exist-li-1",{"children":"Email threads started from the published contact address."}],["$","li","2. What personal data may exist-li-2",{"children":"Short-lived technical logs (IP, user agent, timestamps) retained by hosting infrastructure."}]]}],null]}],["$","$Le","3. What this deletion request covers",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"3. What this deletion request covers"}],[["$","p","3. What this deletion request covers-p-0",{"children":"Upon a verified request, we will take reasonable steps to:"}]],["$","ul",null,{"children":[["$","li","3. What this deletion request covers-li-0",{"children":"Delete or irreversibly anonymize contact-form records and related inbox copies under our control."}],["$","li","3. What this deletion request covers-li-1",{"children":"Remove your personal details from any local notes maintained solely for responding to your enquiry."}],["$","li","3. What this deletion request covers-li-2",{"children":"Confirm completion (or explain any limited retention that still applies)."}]]}],null]}],["$","$Le","4. What deletion typically does not cover",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"4. What deletion typically does not cover"}],[["$","p","4. What deletion typically does not cover-p-0",{"children":"Some information is outside a visitor data-deletion request or may be retained where necessary:"}]],["$","ul",null,{"children":[["$","li","4. What deletion typically does not cover-li-0",{"children":"Public portfolio content (case studies, skills, industry lists, résumé summary) that does not store your personal contact details as a Site user."}],["$","li","4. What deletion typically does not cover-li-1",{"children":"Aggregated or anonymized operational metrics that cannot reasonably identify you."}],["$","li","4. What deletion typically does not cover-li-2",{"children":"Data retained briefly for security, fraud prevention, legal compliance, or dispute resolution."}],"$Lf","$L10"]}],null]}],"$L11","$L12","$L13","$L14","$L15"],"$L16"]}]}]],null,"$L17"]}]
