12:["$","$L10",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Control Plane vs Execution Plane"}],["$","p",null,{"children":"One of the key architectural decisions was to avoid making the application itself responsible for executing every automation step."}],["$","p",null,{"children":[["$","strong",null,{"children":"Application"}]," → defines and manages automation",["$","br",null,{}],["$","strong",null,{"children":"n8n"}]," → executes automation"]}],["$","p",null,{"children":"This separation makes the architecture easier to scale and maintain."}]]}]
13:["$","$L10",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Automation Lifecycle"}],["$","p",null,{"children":"When a user creates an automation:"}],["$","pre",null,{"className":"code-block","children":"User creates automation\n        ↓\nApplication stores definition\n        ↓\nAutomation converted to n8n workflow\n        ↓\nn8n workflow created through API\n        ↓\nWorkflow activated\n        ↓\nn8n executes workflow\n        ↓\nExecution status captured\n        ↓\nApplication dashboard updated"}],["$","p",null,{"children":["The application stores the corresponding ",["$","strong",null,{"children":"n8n workflow ID"}],", allowing the automation to be managed and tracked from the main application."]}]]}]
14:["$","$L10",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Example Business Automation"}],["$","p",null,{"children":"A typical marketing automation could follow:"}],["$","pre",null,{"className":"code-block","children":"Schedule Trigger\n       ↓\nRetrieve Contacts\n       ↓\nBatch Contacts\n       ↓\nLoad Email Template\n       ↓\nRender Personalized Email\n       ↓\nSend Email\n       ↓\nLog Result\n       ↓\nUpdate CRM"}],["$","p",null,{"children":"This approach allows a single workflow to automate a complete business process rather than just one isolated action."}]]}]
15:["$","$L10",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"AI + n8n"}],["$","p",null,{"children":"n8n can also act as the orchestration layer for AI-powered workflows."}],["$","pre",null,{"className":"code-block","children":"Incoming Request\n       ↓\n      n8n\n       ↓\n   AI Agent\n       ↓\nContext / Knowledge\n       ↓\n    Decision\n       ↓\n ┌─────┼──────┐\n ↓     ↓      ↓\nCRM   Email   API\n       ↓\n   Log Result"}],["$","p",null,{"children":["The architectural principle is: ",["$","strong",null,{"children":"AI decides; automation executes."}]]}],["$","p",null,{"children":"AI can interpret information, classify requests or determine an appropriate action, while n8n performs the deterministic operations against business systems."}]]}]
16:["$","$L10",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Potential Automation Use Cases"}],["$","p",null,{"children":"The same architecture can support multiple workflows:"}],["$","div",null,{"className":"card-grid","children":[["$","article","Lead Automation",{"className":"info-card","children":[["$","h3",null,{"children":"Lead Automation"}],["$","pre",null,{"className":"code-block","children":"Lead Capture\n → AI Qualification\n → CRM Update\n → Sales Notification\n → Follow-up"}]]}],["$","article","Customer Support",{"className":"info-card","children":[["$","h3",null,{"children":"Customer Support"}],["$","pre",null,{"className":"code-block","children":"Customer Message\n → AI Classification\n → Knowledge Retrieval\n → CRM / Ticket Lookup\n → Response\n → Conversation Logging"}]]}],["$","article","Marketing",{"className":"info-card","children":[["$","h3",null,{"children":"Marketing"}],["$","pre",null,{"className":"code-block","children":"Audience\n → Content Generation\n → Personalization\n → Email\n → Campaign Tracking\n → CRM Update"}]]}],["$","article","Document Processing",{"className":"info-card","children":[["$","h3",null,{"children":"Document Processing"}],["$","pre",null,{"className":"code-block","children":"Document\n → Extraction\n → AI Analysis\n → Classification\n → Database\n → Notification"}]]}],["$","article","Reporting",{"className":"info-card","children":[["$","h3",null,{"children":"Reporting"}],["$","pre",null,{"className":"code-block","children":"Data Sources\n → Collect\n → Transform\n → Analyze\n → Generate Report\n → Distribute"}]]}]]}]]}]
17:["$","$L10",null,{"as":"article","className":"case-block","children":[["$","h2",null,{"children":"Scalability"}],["$","p",null,{"children":"For higher-volume automation workloads, the architecture can use n8n's queue-based execution model with Redis and worker processes."}],["$","pre",null,{"className":"code-block","children":"                 ┌──────────────┐\n                 │ n8n Main     │\n                 │ Instance     │\n                 └──────┬───────┘\n                        │\n                        ▼\n                 ┌──────────────┐\n                 │    Redis     │\n                 │    Queue     │\n                 └──────┬───────┘\n                        │\n              ┌─────────┼─────────┐\n              ▼         ▼         ▼\n           Worker 1  Worker 2  Worker 3\n              │         │         │\n              └─────────┼─────────┘\n                        ▼\n                  External APIs"}],["$","p",null,{"children":"This separates workflow orchestration from execution capacity and provides a path toward handling larger numbers of concurrent workflows."}]]}]
