10:["$","p","4. Contact form and email access-p-1",{"children":"Do not include secrets, passwords, or highly sensitive personal data in the contact form. Prefer a high-level project description first; share confidential details only after a trusted channel is agreed."}]
11:["$","$Lf","5. Social and professional platforms",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"5. Social and professional platforms"}],[["$","p","5. Social and professional platforms-p-0",{"children":"The Site links to professional profiles such as LinkedIn and GitHub. Those platforms may set their own cookies and collect data if you interact with them. The Operator does not control third-party tracking on those destinations."}],["$","p","5. Social and professional platforms-p-1",{"children":"Portfolio content describing industries and technologies may reference tools (for example React, Node.js, n8n, cloud platforms). Naming a technology does not grant that vendor access to your contact data from this Site."}]],null,null]}]
12:["$","$Lf","6. What third parties do not get",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"6. What third parties do not get"}],[["$","p","6. What third parties do not get-p-0",{"children":"Unless required for the purposes above, third parties are not given:"}]],["$","ul",null,{"children":[["$","li","6. What third parties do not get-li-0",{"children":"Permission to use your contact details for their own marketing."}],["$","li","6. What third parties do not get-li-1",{"children":"Bulk exports of enquiry data for resale."}],["$","li","6. What third parties do not get-li-2",{"children":"Access to private client systems described only at a high level in case studies."}]]}],null]}]
13:["$","$Lf","7. Your controls",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"7. Your controls"}],[["$","p","7. Your controls-p-0",{"children":"You can avoid sharing personal data by browsing without using the contact form. You can request deletion of enquiry-related personal data via the Data Deletion page. You can block non-essential cookies in your browser; essential hosting and security functions may still operate."}]],null,null]}]
14:["$","$Lf","8. Changes to processors",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"8. Changes to processors"}],[["$","p","8. Changes to processors-p-0",{"children":"Hosting, email, or CDN providers may change as the portfolio infrastructure evolves. Material changes that affect how visitor data is processed will be reflected in updates to this page and the Privacy Policy."}]],null,null]}]
15:["$","$Lf","9. Contact",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"9. Contact"}],[["$","p","9. Contact-p-0",{"children":"Questions about third-party access: tushant.rajpal23@gmail.com"}],["$","p","9. Contact-p-1",{"children":"Operator: Tushant Rajpal — Senior Full Stack Engineer | Full Stack Architect"}]],null,null]}]
