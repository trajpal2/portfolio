b:["$","$1","c",{"children":[[["$","section",null,{"className":"page-hero-band","children":["$","div",null,{"className":"section__inner","children":[["$","p",null,{"className":"eyebrow","children":"Legal"}],["$","h1",null,{"children":"Third-Party Access"}],["$","p",null,{"className":"section__lead page-hero-band__lead","children":"Which external services may process data when you use Tushant Rajpal's portfolio, and what that means for your privacy."}],null]}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"section__inner legal-doc","children":[["$","p",null,{"className":"legal-doc__updated","children":["Last updated: ","August 30, 2026"]}],[["$","$Lf","1. Overview",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"1. Overview"}],[["$","p","1. Overview-p-0",{"children":"This personal portfolio is built and operated by Tushant Rajpal to showcase engineering work across multiple industries and technologies. Running a modern website and contact channel inevitably involves a small set of third-party infrastructure providers."}],["$","p","1. Overview-p-1",{"children":"This page describes those categories of access so visitors understand who may process technical or contact-related data — and confirms that personal information is not sold or rented."}]],null,null]}],["$","$Lf","2. Principles",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"2. Principles"}],[["$","p","2. Principles-p-0",{"children":"Third-party access on this Site follows these rules:"}]],["$","ul",null,{"children":[["$","li","2. Principles-li-0",{"children":"Access is limited to what is needed to host pages, deliver email, and keep the Site secure."}],["$","li","2. Principles-li-1",{"children":"Providers act as processors or infrastructure partners, not as buyers of your personal data."}],["$","li","2. Principles-li-2",{"children":"No advertising networks or data brokers are intentionally integrated into this portfolio."}],["$","li","2. Principles-li-3",{"children":"Outbound links (LinkedIn, GitHub, etc.) are optional; leaving the Site means those platforms’ own terms apply."}]]}],null]}],["$","$Lf","3. Categories of third parties",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"3. Categories of third parties"}],[["$","p","3. Categories of third parties-p-0",{"children":"Depending on configuration and hosting, the following types of services may process data:"}]],["$","ul",null,{"children":[["$","li","3. Categories of third parties-li-0",{"children":"Web hosting / application hosting — serves HTML/CSS/JS, handles HTTPS, and may keep access logs (IP, user agent, timestamps)."}],["$","li","3. Categories of third parties-li-1",{"children":"Email / SMTP delivery — sends the Operator a notification when you use the contact form and may send you a confirmation message."}],["$","li","3. Categories of third parties-li-2",{"children":"DNS / CDN / edge network (if enabled by the host) — routes traffic and may cache public assets for performance."}],["$","li","3. Categories of third parties-li-3",{"children":"Search and verification tools — for example Google Search Console site verification metadata used for indexing the public portfolio (not for selling visitor profiles)."}],["$","li","3. Categories of third parties-li-4",{"children":"Open-source and cloud technology references in case studies — descriptive only; visiting those vendors’ sites is separate from this portfolio."}]]}],null]}],["$","$Lf","4. Contact form and email access",{"as":"article","className":"legal-doc__block","children":[["$","h2",null,{"children":"4. Contact form and email access"}],[["$","p","4. Contact form and email access-p-0",{"children":"When you submit the contact form, your message content and email address are transmitted to the configured mail infrastructure so the Operator can reply. That means the SMTP provider and the Operator’s mailbox provider can process message contents for delivery."}],"$L10"],null,null]}],"$L11","$L12","$L13","$L14","$L15"],"$L16"]}]}]],null,"$L17"]}]
