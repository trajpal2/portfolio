e:T1275,{"@context":"https://schema.org","@type":"ItemList","name":"Portfolio Case Studies","itemListElement":[{"@type":"ListItem","position":1,"name":"Enterprise Insurance Platform","url":"http://localhost:3000/case-studies/insurance-platform","description":"Enterprise-grade insurance application demonstrating complex business workflows, secure APIs and cloud-ready architecture."},{"@type":"ListItem","position":2,"name":"Modernizing Conversational AI with Google ADK","url":"http://localhost:3000/case-studies/dialogflow-google-adk","description":"From linear Dialogflow flows to specialized AI agents with sequential, parallel and graph-based orchestration."},{"@type":"ListItem","position":3,"name":"n8n-Based Business Automation Platform","url":"http://localhost:3000/case-studies/ai-n8n-automation","description":"Architected an automation platform using a custom Node.js/PostgreSQL control plane and n8n execution engine, enabling businesses to create, execute, monitor and scale AI-powered workflows across CRM, marketing, email and internal systems."},{"@type":"ListItem","position":4,"name":"Automated LinkedIn Personal Branding System","url":"http://localhost:3000/case-studies/linkedin-personal-branding","description":"AI + n8n LinkedIn content automation that discovers topics, generates posts and visuals, and publishes with human approval in the loop."},{"@type":"ListItem","position":5,"name":"Crypto Options Algorithmic Trading Platform","url":"http://localhost:3000/case-studies/crypto-options-trading","description":"Modular Python architecture for cryptocurrency options algorithmic trading with leverage, pluggable strategies, independent backtesting and risk management."},{"@type":"ListItem","position":6,"name":"AI Video-to-Text Transcription Pipeline","url":"http://localhost:3000/case-studies/ai-video-transcription","description":"Python pipeline that converts online video/audio into usable text for summarization, content repurposing and AI analysis — Video → Text, not Video → downloaded file."},{"@type":"ListItem","position":7,"name":"Modernizing a React Testing Stack","url":"http://localhost:3000/case-studies/jest-to-vitest-migration","description":"Jest → Vitest migration for a Vite + React application, systematically replacing Jest APIs and aligning the test stack with the Vite ecosystem."},{"@type":"ListItem","position":8,"name":"Full-Stack Backend Optimization","url":"http://localhost:3000/case-studies/fullstack-backend-optimization","description":"Improving performance, maintainability and scalability of an existing application through measured architecture review, API and database optimization — without a full rewrite."},{"@type":"ListItem","position":9,"name":"CRA → Vite Migration","url":"http://localhost:3000/case-studies/cra-to-vite-migration","description":"Modernized a React app by migrating from Create React App to Vite — improving DX and build tooling without rewriting the application."},{"@type":"ListItem","position":10,"name":"AI Integration in CRM","url":"http://localhost:3000/case-studies/ai-crm-integration","description":"Integrated AI into a CRM platform for summarization, lead analysis, intelligent search and follow-up assistance — with context-aware LLM workflows."},{"@type":"ListItem","position":11,"name":"Education CRM","url":"http://localhost:3000/case-studies/education-crm","description":"Education-focused CRM for managing prospective students, admissions, communication and operational workflows through a centralized platform."},{"@type":"ListItem","position":12,"name":"LinkedIn Automation","url":"http://localhost:3000/case-studies/linkedin-automation","description":"AI-powered LinkedIn content and publishing automation with n8n — trend discovery, content generation, visuals, human approval and LinkedIn publishing."},{"@type":"ListItem","position":13,"name":"Marketing Email Automation","url":"http://localhost:3000/case-studies/marketing-email-automation","description":"Automated, personalized marketing communication with n8n — audience selection, AI content generation, email delivery, tracking and CRM updates."},{"@type":"ListItem","position":14,"name":"AI Content Creation Platform","url":"http://localhost:3000/case-studies/ai-content-creation-platform","description":"An AI-powered content generation and repurposing system — structured pipelines for research, writing, editing, visuals and multi-format publishing."},{"@type":"ListItem","position":15,"name":"Website Development","url":"http://localhost:3000/case-studies/website-development","description":"Designed and developed a modern, conversion-focused website with modular React architecture, responsive UX, performance and SEO considerations."}]}a:["$","$1","c",{"children":[[[["$","script","ItemList-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$e"}}]],"$Lf","$L10"],null,"$L11"]}]
