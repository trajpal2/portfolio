# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Explicit: never commit dev server / Turbopack cache (single .sst files can exceed GitHub's 100 MB limit).
.next/dev/
.next/cache/

/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local lead storage (PII) — JSON file e.g. data/leads.json
/data/

# Contact API diagnostics (append-only; may contain field names / error metadata)
/logs/

# Generated by `npm run generate:sitemap` (optional static copy; live site uses `app/sitemap.ts`)
/public/sitemap.xml